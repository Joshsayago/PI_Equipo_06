        "\n",
        "x, y = test_dataset_tl[idx]\n",
        "\n",
        "# Calculamos Grad-CAM\n",
        "cam, pred_class = grad_cam(\n",
        "    resnet,\n",
        "    x\n",
        ")\n",
        "\n",
        "# Convertimos la imagen para poder mostrarla\n",
        "img = x.permute(\n",
        "    1,\n",
        "    2,\n",
        "    0\n",
        ").cpu().numpy()\n",
        "\n",
        "# Valores usados en la normalización\n",
        "mean = np.array([\n",
        "    0.485,\n",
        "    0.456,\n",
        "    0.406\n",
        "])\n",
        "\n",
        "std = np.array([\n",
        "    0.229,\n",
        "    0.224,\n",
        "    0.225\n",
        "])\n",
        "\n",
        "# Desnormalizamos la imagen\n",
        "img = std * img + mean\n",
        "\n",
        "img = np.clip(\n",
        "    img,\n",
        "    0,\n",
        "    1\n",
        ")\n",
        "\n",
        "# Nombre de las clases\n",
        "nombres_clases = {\n",
        "    0: \"Nevus\",\n",
        "    1: \"Melanoma\"\n",
        "}\n",
        "\n",
        "# Mostrar imagen, Grad-CAM y superposición\n",
        "plt.figure(figsize=(12, 4))\n",
        "\n",
        "# Imagen original\n",
        "plt.subplot(1, 3, 1)\n",
        "\n",
        "plt.imshow(img)\n",
        "\n",
        "plt.title(\n",
        "    f\"Real: {nombres_clases[int(y.item())]}\"\n",
        ")\n",
        "\n",
        "plt.axis(\"off\")\n",
        "\n",
        "# Mapa Grad-CAM\n",
        "plt.subplot(1, 3, 2)\n",
        "\n",
        "plt.imshow(\n",
        "    cam,\n",
        "    cmap=\"jet\"\n",
        ")\n",
        "\n",
        "plt.title(\n",
        "    f\"Grad-CAM: {nombres_clases[pred_class]}\"\n",
        ")\n",
        "\n",
        "plt.axis(\"off\")\n",
        "\n",
        "# Superposición\n",
        "plt.subplot(1, 3, 3)\n",
        "\n",
        "plt.imshow(img)\n",
        "\n",
        "plt.imshow(\n",
        "    cam,\n",
        "    cmap=\"jet\",\n",
        "    alpha=0.5\n",
        ")\n",
        "\n",
        "plt.title(\"Superposición\")\n",
        "\n",
        "plt.axis(\"off\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
