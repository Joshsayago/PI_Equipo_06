        "# 15. Grad-CAM\n",
        "\n",
        "Grad-CAM permite observar qué zonas de la imagen influyeron más en la decisión de ResNet18."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "d6706929",
      "metadata": {
        "id": "d6706929"
      },
      "outputs": [],
      "source": [
        "# Grad-CAM nos permite observar qué partes de la imagen\n",
        "# fueron importantes para que ResNet18 tome su decisión\n",
        "def grad_cam(model, image_tensor, target_class=None):\n",
        "\n",
        "    # Ponemos el modelo en modo evaluación\n",
        "    model.eval()\n",
        "\n",
        "    # Agregamos una dimensión porque el modelo espera un lote\n",
        "    # y activamos gradientes para poder calcular Grad-CAM\n",
        "    x = image_tensor.unsqueeze(0).to(device)\n",
        "    x.requires_grad_(True)\n",
        "\n",
        "    # Aquí guardaremos las activaciones de la última capa convolucional\n",
        "    activations = {}\n",
        "\n",
        "    # Esta función guarda la salida de layer4\n",
        "    def forward_hook(module, input, output):\n",
        "        activations[\"value\"] = output\n",
        "\n",
        "    # Colocamos el hook en la última capa convolucional de ResNet18\n",
        "    handle = model.layer4.register_forward_hook(\n",
        "        forward_hook\n",
        "    )\n",
        "\n",
        "    # Reiniciamos gradientes anteriores\n",
        "    model.zero_grad()\n",
        "\n",
        "    # Hacemos la predicción\n",
        "    logits = model(x)\n",
        "\n",
        "    # Si no indicamos una clase, usamos la clase predicha\n",
        "    if target_class is None:\n",
        "        target_class = logits.argmax(\n",
        "            dim=1\n",
        "        ).item()\n",
        "\n",
        "    # Tomamos la salida correspondiente a esa clase\n",
        "    score = logits[\n",
        "        0,\n",
        "        target_class\n",
        "    ]\n",
        "\n",
        "    # Guardamos los gradientes de las activaciones\n",
        "    activations[\"value\"].retain_grad()\n",
        "\n",
        "    # Calculamos los gradientes\n",
        "    score.backward()\n",
        "\n",
        "    # Obtenemos activaciones y gradientes\n",
        "    act = activations[\n",
        "        \"value\"\n",
        "    ][0]\n",
        "\n",
        "    grad = activations[\n",
        "        \"value\"\n",
        "    ].grad[0]\n",
        "\n",
        "    # Calculamos la importancia promedio de cada canal\n",
        "    weights = grad.mean(\n",
        "        dim=(1, 2)\n",
        "    )\n",
        "\n",
        "    # Creamos el mapa Grad-CAM\n",
        "    cam = torch.sum(\n",
        "        weights[:, None, None] * act,\n",
        "        dim=0\n",
        "    )\n",
        "\n",
        "    # Dejamos solo valores positivos\n",
        "    cam = torch.relu(cam)\n",
        "\n",
        "    # Normalizamos entre 0 y 1\n",
        "    cam = cam - cam.min()\n",
        "\n",
        "    cam = cam / (\n",
        "        cam.max() + 1e-8\n",
        "    )\n",
        "\n",
        "    # Quitamos el hook\n",
        "    handle.remove()\n",
        "\n",
        "    return (\n",
        "        cam.detach().cpu().numpy(),\n",
        "        int(target_class)\n",
        "    )"
      ]
    },
