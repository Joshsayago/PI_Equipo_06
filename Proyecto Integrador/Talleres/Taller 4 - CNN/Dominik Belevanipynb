        "# Esta será nuestra CNN sencilla de referencia\n",
        "class CNNBase(nn.Module):\n",
        "\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "\n",
        "        self.features = nn.Sequential(\n",
