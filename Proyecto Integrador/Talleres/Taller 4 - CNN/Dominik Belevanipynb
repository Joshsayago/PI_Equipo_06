      "outputs": [],
      "source": [
        "# Esta función realiza una época completa de entrenamiento\n",
        "def train_one_epoch(model, loader, optimizer, criterion):\n",
        "\n",
        "    # Ponemos el modelo en modo entrenamiento\n",
        "    model.train()\n",
        "\n",
        "    running_loss = 0.0\n",
        "\n",
        "    for images, labels in loader:\n",
        "\n",
        "        # Enviamos los datos a GPU o CPU\n",
        "        images = images.to(device)\n",
        "        labels = labels.to(device)\n",
        "\n",
        "        # Reiniciamos los gradientes\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        # El modelo hace una predicción\n",
        "        logits = model(images)\n",
        "\n",
        "        # Calculamos el error\n",
        "        loss = criterion(logits, labels)\n",
        "\n",
        "        # Calculamos los gradientes\n",
        "        loss.backward()\n",
        "\n",
        "        # Actualizamos los pesos\n",
        "        optimizer.step()\n",
        "\n",
        "        running_loss += loss.item() * images.size(0)\n",
        "\n",
        "    # Devolvemos la pérdida promedio\n",
        "    return running_loss / len(loader.dataset)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "f00af02b",
      "metadata": {
        "id": "f00af02b"
      },
      "outputs": [],
      "source": [
        "# Esta función permite calcular Accuracy y ROC-AUC\n",
        "# sin modificar los pesos del modelo\n",
        "def evaluate(model, loader):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    y_true = []\n",
        "    y_pred = []\n",
        "    y_prob = []\n",
        "\n",
        "    # No necesitamos gradientes durante la evaluación\n",
        "    with torch.no_grad():\n",
        "\n",
        "        for images, labels in loader:\n",
        "\n",
        "            images = images.to(device)\n",
        "\n",
        "            # Obtener las salidas del modelo\n",
        "            logits = model(images)\n",
        "\n",
        "            # Convertir las salidas en probabilidades\n",
        "            probs = torch.softmax(logits, dim=1)\n",
        "\n",
        "            # Elegir la clase con mayor probabilidad\n",
        "            preds = torch.argmax(probs, dim=1)\n",
        "\n",
        "            # Guardar etiquetas reales\n",
        "            y_true.extend(labels.numpy())\n",
        "\n",
        "            # Guardar predicciones\n",
        "            y_pred.extend(preds.cpu().numpy())\n",
        "\n",
        "            # Guardar probabilidad de Melanoma\n",
        "            y_prob.extend(probs[:, 1].cpu().numpy())\n",
        "\n",
        "    # Accuracy indica el porcentaje de aciertos\n",
        "    acc = accuracy_score(y_true, y_pred)\n",
        "\n",
        "    # ROC-AUC evalúa qué tan bien separa las dos clases\n",
        "    auc = roc_auc_score(y_true, y_prob)\n",
        "\n",
        "    return (\n",
        "        acc,\n",
        "        auc,\n",
        "        np.array(y_true),\n",
        "        np.array(y_pred),\n",
        "        np.array(y_prob)\n",
        "    )"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "51b60d11",
      "metadata": {
        "id": "51b60d11"
      },
      "outputs": [],
      "source": [
        "# Esta función entrena el modelo durante varias épocas\n",
        "# y guarda las métricas para después hacer gráficas\n",
        "def fit_model(\n",
        "    model,\n",
        "    train_loader,\n",
        "    val_loader,\n",
        "    optimizer,\n",
        "    criterion,\n",
        "    epochs=10,\n",
        "    scheduler=None\n",
        "):\n",
        "\n",
        "    history = {\n",
        "        \"train_loss\": [],\n",
        "        \"val_acc\": [],\n",
        "        \"val_auc\": []\n",
        "    }\n",
        "\n",
        "    # Guardaremos el modelo que obtenga el mejor AUC\n",
        "    best_auc = -1\n",
        "    best_model = copy.deepcopy(model.state_dict())\n",
        "\n",
        "    # Entrenamos durante 10 épocas\n",
        "    for epoch in range(1, epochs + 1):\n",
        "\n",
        "        # Entrenar una época\n",
        "        train_loss = train_one_epoch(\n",
        "            model,\n",
        "            train_loader,\n",
        "            optimizer,\n",
        "            criterion\n",
        "        )\n",
        "\n",
        "        # Evaluar con validación\n",
        "        val_acc, val_auc, _, _, _ = evaluate(\n",
        "            model,\n",
        "            val_loader\n",
        "        )\n",
        "\n",
        "        # Si usamos scheduler, actualizamos el learning rate\n",
        "        if scheduler is not None:\n",
        "\n",
        "            if isinstance(\n",
        "                scheduler,\n",
        "                torch.optim.lr_scheduler.ReduceLROnPlateau\n",
        "            ):\n",
        "                scheduler.step(val_auc)\n",
        "\n",
        "            else:\n",
        "                scheduler.step()\n",
        "\n",
        "        # Guardamos las métricas\n",
        "        history[\"train_loss\"].append(train_loss)\n",
        "        history[\"val_acc\"].append(val_acc)\n",
        "        history[\"val_auc\"].append(val_auc)\n",
        "\n",
        "        # Guardamos la mejor versión del modelo\n",
        "        if val_auc > best_auc:\n",
        "            best_auc = val_auc\n",
        "            best_model = copy.deepcopy(model.state_dict())\n",
        "\n",
        "        # Mostramos resultados de cada época\n",
        "        print(\n",
        "            f\"Época {epoch:02d}/{epochs} | \"\n",
        "            f\"Loss={train_loss:.4f} | \"\n",
        "            f\"Val Acc={val_acc:.4f} | \"\n",
        "            f\"Val AUC={val_auc:.4f}\"\n",
        "        )\n",
        "\n",
        "    # Recuperamos el mejor modelo encontrado\n",
        "    model.load_state_dict(best_model)\n",
        "\n",
        "    return history"
      ]
    },
