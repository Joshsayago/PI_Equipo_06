      "source": [
        "### Obtener logits"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "ab0e07b6",
      "metadata": {
        "id": "ab0e07b6"
      },
      "outputs": [],
      "source": [
        "# Necesitamos los logits, es decir las salidas antes de softmax,\n",
        "# para poder calibrar las probabilidades\n",
        "def get_logits(model, loader):\n",
        "\n",
        "    model.eval()\n",
        "\n",
        "    logits_all = []\n",
        "    labels_all = []\n",
        "\n",
        "    with torch.no_grad():\n",
        "\n",
        "        for images, labels in loader:\n",
        "\n",
        "            images = images.to(device)\n",
        "\n",
        "            logits = model(images)\n",
        "\n",
        "            logits_all.append(\n",
        "                logits.cpu()\n",
        "            )\n",
        "\n",
        "            labels_all.append(\n",
        "                labels\n",
        "            )\n",
        "\n",
        "    return (\n",
        "        torch.cat(logits_all),\n",
        "        torch.cat(labels_all)\n",
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "0b8aaa1d",
      "metadata": {
        "id": "0b8aaa1d"
      },
      "source": [
        "### Temperature Scaling"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "bdb69092",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "bdb69092",
        "outputId": "710554b1-ed4a-47db-e93b-402458feeae6"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Temperatura encontrada: 1.1845420598983765\n"
          ]
        }
      ],
      "source": [
        "# Usamos validación para encontrar la temperatura\n",
        "# y no utilizamos directamente los datos de prueba\n",
        "val_logits, val_labels = get_logits(\n",
        "    modelo_final,\n",
        "    val_loader\n",
        ")\n",
        "\n",
        "# Temperature Scaling ajusta la confianza\n",
        "# de las probabilidades del modelo\n",
        "\n",
        "# Usamos log_temperature para asegurar que la temperatura\n",
        "# siempre tenga un valor positivo\n",
        "log_temperature = nn.Parameter(\n",
        "    torch.zeros(\n",
        "        1,\n",
        "        device=device\n",
        "    )\n",
        ")\n",
        "\n",
        "val_logits_device = val_logits.to(device)\n",
        "val_labels_device = val_labels.to(device)\n",
        "\n",
        "criterion_cal = nn.CrossEntropyLoss()\n",
        "\n",
        "# LBFGS se utiliza para encontrar un buen valor de temperatura\n",
        "optimizer_temp = torch.optim.LBFGS(\n",
        "    [log_temperature],\n",
        "    lr=0.01,\n",
        "    max_iter=50\n",
        ")\n",
        "\n",
        "# Esta función calcula el error usando\n",
        "# diferentes valores de temperatura\n",
        "def closure():\n",
        "\n",
        "    optimizer_temp.zero_grad()\n",
        "\n",
        "    temperature = torch.exp(\n",
        "        log_temperature\n",
        "    )\n",
        "\n",
        "    loss = criterion_cal(\n",
        "        val_logits_device / temperature,\n",
        "        val_labels_device\n",
        "    )\n",
        "\n",
        "    loss.backward()\n",
        "\n",
        "    return loss\n",
        "\n",
        "# Optimizamos la temperatura\n",
        "optimizer_temp.step(closure)\n",
        "\n",
        "# Obtenemos el valor final\n",
        "temperature = torch.exp(\n",
        "    log_temperature\n",
        ").detach()\n",
        "\n",
        "print(\n",
        "    \"Temperatura encontrada:\",\n",
        "    temperature.item()\n",
        ")"
      ]
    },
